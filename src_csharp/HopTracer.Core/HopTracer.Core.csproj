<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <Reference Include="GH_IO">
      <HintPath>..\HopTracer.Web\tools\GH_IO.dll</HintPath>
    </Reference>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <Target Name="CopyGhIoDll" BeforeTargets="BeforeBuild" Condition="!Exists('$(MSBuildProjectDirectory)\..\HopTracer.Web\tools\GH_IO.dll')">
    <Exec Command="powershell -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\setup_dependencies.ps1&quot;" />
  </Target>

</Project>
