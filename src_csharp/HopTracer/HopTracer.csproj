<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2895.51" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HopTracer.Web\HopTracer.Web.csproj" />
  </ItemGroup>

  <!-- Copy wwwroot files to output -->
  <ItemGroup>
    <Content Include="..\HopTracer.Web\wwwroot\**\*.*">
      <Link>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Ensure tools directory is copied if it exists -->
  <ItemGroup>
    <None Include="..\..\tools\**\*.*" Condition="Exists('..\..\tools')">
      <Link>tools\%(RecursiveDir)%(FileName)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
