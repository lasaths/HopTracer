            <chunk name="Object" index="4">
              <items count="3">
                <item name="GUID" type_name="gh_guid" type_code="9">410755b1-224a-4c1e-a407-bf32fb45ea7e</item>
                <item name="Lib" type_name="gh_guid" type_code="9">00000000-0000-0000-0000-000000000000</item>
                <item name="Name" type_name="gh_string" type_code="10">GhPython Script</item>
              </items>
              <chunks count="1">
                <chunk name="Container">
                  <items count="13">
                    <item name="CodeInput" type_name="gh_string" type_code="10">import math
import Rhino.Geometry as rg

# Generate spiral polyline points
points = []
for i in range(int(segments) + 1):
    t = float(i) / float(segments) * turns * 2 * math.pi
    radius = base_radius + (height / turns) * (t / (2 * math.pi)) * 0.1
    x = radius * math.cos(t)
    y = radius * math.sin(t)
    z = (float(i) / float(segments)) * height
    points.append(rg.Point3d(x, y, z))

# Create polyline
spiral = rg.Polyline(points)
spiral_polyline = spiral.ToPolylineCurve()

a = spiral_polyline</item>
                    <item name="Description" type_name="gh_string" type_code="10">GhPython provides a Python script component</item>
