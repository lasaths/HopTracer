<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- HopTracer Design System Colors (Apple-inspired pro app) -->
    
    <!-- Base layers -->
    <Color x:Key="HtBackgroundBase">#000000</Color>
    <Color x:Key="HtBackgroundCanvas">#000000</Color>
    <Color x:Key="HtBackgroundElevated1">#0f0f0f</Color>
    <Color x:Key="HtBackgroundElevated2">#1a1a1a</Color>
    <Color x:Key="HtBackgroundElevated3">#252525</Color>
    
    <!-- Text -->
    <Color x:Key="HtTextPrimary">#ffffff</Color>
    <Color x:Key="HtTextSecondary">#98989d</Color>
    <Color x:Key="HtTextTertiary">#636366</Color>
    
    <!-- Borders -->
    <Color x:Key="HtBorderSubtle">#2a2a2a</Color>
    <Color x:Key="HtBorderStrong">#3a3a3a</Color>
    
    <!-- Status colors (ANDURA logic: grey when normal, colour when abnormal) -->
    <Color x:Key="HtStatusUnchanged">#636366</Color>
    <Color x:Key="HtStatusAdded">#30d158</Color>
    <Color x:Key="HtStatusModified">#ffd60a</Color>
    <Color x:Key="HtStatusRemoved">#ff453a</Color>
    
    <!-- Accent -->
    <Color x:Key="HtAccent">#0a84ff</Color>
    <Color x:Key="HtAccentHover">#409cff</Color>
    
    <!-- Standard .NET MAUI semantic colors (mapped to design system) -->
    <Color x:Key="Primary">#0a84ff</Color>
    <Color x:Key="Secondary">#636366</Color>
    <Color x:Key="Tertiary">#30d158</Color>
    
    <Color x:Key="Gray100">#ffffff</Color>
    <Color x:Key="Gray200">#98989d</Color>
    <Color x:Key="Gray300">#636366</Color>
    <Color x:Key="Gray400">#48484a</Color>
    <Color x:Key="Gray500">#3a3a3a</Color>
    <Color x:Key="Gray600">#2a2a2a</Color>
    <Color x:Key="Gray900">#0f0f0f</Color>
    <Color x:Key="Gray950">#000000</Color>

    <Color x:Key="White">#ffffff</Color>
    <Color x:Key="Black">#000000</Color>
</ResourceDictionary>
