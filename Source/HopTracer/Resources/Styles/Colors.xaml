<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- ANDURA Design System Colors (dark-only, monochrome, type-led UI)
         Source: https://github.com/lasaths/andura-skill (commit 963ae3c)
         License: MIT
         Tokens from andura.tokens.json via export to Andura.cs -->

    <!-- Primary Palette (v2.2) -->
    <Color x:Key="Void">#000000</Color>
    <Color x:Key="Surface">#090A0C</Color>
    <Color x:Key="SurfaceHover">#141518</Color>
    <Color x:Key="SurfaceLift">#1A1B1E</Color>
    <Color x:Key="Line">#3C3D41</Color>
    <Color x:Key="Muted">#8A8C91</Color>
    <Color x:Key="Text">#DADADD</Color>
    
    <!-- Accent & Selection -->
    <Color x:Key="Ultramarine">#3A3CFF</Color>
    <Color x:Key="UltramarineText">#5A74F1</Color>
    <Color x:Key="OnUltramarine">#DADADD</Color>
    
    <!-- Status Colors (color only for abnormal states) -->
    <Color x:Key="Emergency">#F45536</Color>
    <Color x:Key="Caution">#FBB636</Color>
    <Color x:Key="Nominal">#44B782</Color>
    
    <!-- Legacy Compatibility Mappings -->
    <Color x:Key="Primary">#3A3CFF</Color>
    <Color x:Key="PrimaryDark">#3A3CFF</Color>
    <Color x:Key="PrimaryDarkText">#DADADD</Color>
    <Color x:Key="Secondary">#141518</Color>
    <Color x:Key="SecondaryDarkText">#8A8C91</Color>
    <Color x:Key="Tertiary">#3A3CFF</Color>
    
    <Color x:Key="White">#DADADD</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Magenta">#3A3CFF</Color>
    <Color x:Key="MidnightBlue">#000000</Color>
    <Color x:Key="OffBlack">#090A0C</Color>
    
    <!-- Gray Scale (mapped to ANDURA monochrome) -->
    <Color x:Key="Gray100">#DADADD</Color>
    <Color x:Key="Gray200">#8A8C91</Color>
    <Color x:Key="Gray300">#3C3D41</Color>
    <Color x:Key="Gray400">#3C3D41</Color>
    <Color x:Key="Gray500">#3C3D41</Color>
    <Color x:Key="Gray600">#1A1B1E</Color>
    <Color x:Key="Gray900">#141518</Color>
    <Color x:Key="Gray950">#090A0C</Color>
    
    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Ultramarine}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SurfaceHover}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Ultramarine}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource Text}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Void}"/>
    
    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>