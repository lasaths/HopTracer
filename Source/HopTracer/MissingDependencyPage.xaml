<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HopTracer.Maui.MissingDependencyPage"
             Title="GH_IO Required">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Rhino / GH_IO Required"
                   FontSize="26"
                   FontAttributes="Bold" />

            <Label x:Name="SummaryLabel"
                   FontSize="14"
                   LineBreakMode="WordWrap" />

            <Label Text="HopTracer requires Grasshopper's GH_IO.dll and does not bundle this dependency."
                   FontSize="14"
                   LineBreakMode="WordWrap" />

            <Label Text="How to fix"
                   FontSize="18"
                   FontAttributes="Bold" />

            <Label Text="1. Install Rhino 8 or Rhino 7 (Rhino 6 also works)." />
            <Label Text="2. Restart HopTracer and click Retry Detection." />
            <Label Text="3. If needed, manually verify GH_IO.dll exists at one of these paths:" />

            <Label Text="C:\Program Files\Rhino 8\Plug-ins\Grasshopper\GH_IO.dll"
                   FontFamily="OpenSansRegular" />
            <Label Text="C:\Program Files\Rhino 7\Plug-ins\Grasshopper\GH_IO.dll"
                   FontFamily="OpenSansRegular" />
            <Label Text="C:\Program Files\Rhino 6\Plug-ins\Grasshopper\GH_IO.dll"
                   FontFamily="OpenSansRegular" />

            <Label Text="For source builds: run .\scripts\setup_dependencies.ps1"
                   FontFamily="OpenSansRegular" />

            <HorizontalStackLayout Spacing="12" Margin="0,10,0,0">
                <Button Text="Retry Detection"
                        Clicked="OnRetryClicked" />
                <Button Text="Copy Setup Command"
                        Clicked="OnCopyCommandClicked" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="12">
                <Button Text="Open Rhino Download"
                        Clicked="OnOpenRhinoDownloadClicked" />
                <Button Text="Open Setup Docs"
                        Clicked="OnOpenSetupDocsClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
