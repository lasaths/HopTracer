{
 "$description": "ANDURA design tokens, single source of truth (W3C Design Tokens Community Group format). px = dp = CSS px at 1x. Generated exports: scripts/export_tokens.py.",
 "$extensions": {
  "andura": {
   "version": "0.6.0-draft",
   "modes": {
    "sunlit": {
     "$description": "Sunlit-tablet mode: positive polarity (dark on light) with raised contrast for direct sun or > 10 000 lx. Set data-andura-mode=\"sunlit\" on <html>. Same names, same rules; only colour values change. Rationale and when to use: references/colour.md §9.",
     "color": {
      "void": "#F5F5F2",
      "surface": "#E6E6E2",
      "surface-hover": "#D9D9D4",
      "surface-lift": "#FFFFFF",
      "line": "#6E7075",
      "muted": "#3E4045",
      "text": "#0B0B0D",
      "ultramarine": "#2426D6",
      "ultramarine-text": "#1E20B0",
      "emergency": "#B42A12",
      "caution": "#8C5A00",
      "nominal": "#1D6B43",
      "3d.face-1": "#DEDED9",
      "3d.face-2": "#D6D6D1",
      "3d.face-3": "#CFCFCA",
      "3d.base": "#C8C8C3",
      "3d.element": "#C0C0BB",
      "3d.link": "#B4B4AF",
      "3d.joint": "#9C9C97",
      "3d.edge": "#75767A",
      "3d.detail": "#5E6064",
      "3d.link-line": "#4A4C50",
      "3d.joint-line": "#3A3C40",
      "on-ultramarine": "#F5F5F2"
     },
     "contrast-targets": [
      [
       "text",
       "void",
       15
      ],
      [
       "text",
       "surface",
       15
      ],
      [
       "muted",
       "void",
       7
      ],
      [
       "muted",
       "surface",
       7
      ],
      [
       "line",
       "void",
       3
      ],
      [
       "line",
       "surface",
       3
      ],
      [
       "ultramarine",
       "void",
       4.5
      ],
      [
       "ultramarine-text",
       "void",
       4.5
      ],
      [
       "ultramarine-text",
       "surface",
       4.5
      ],
      [
       "emergency",
       "void",
       4.5
      ],
      [
       "emergency",
       "surface",
       4.5
      ],
      [
       "caution",
       "void",
       4.5
      ],
      [
       "caution",
       "surface",
       4.5
      ],
      [
       "emergency",
       "3d.face-3",
       3
      ],
      [
       "caution",
       "3d.face-3",
       3
      ],
      [
       "ultramarine",
       "3d.link",
       3
      ],
      [
       "on-ultramarine",
       "ultramarine",
       4.5
      ]
     ]
    }
   }
  }
 },
 "color": {
  "void": {
   "$type": "color",
   "$value": "#000000",
   "$description": "Outer canvas"
  },
  "surface": {
   "$type": "color",
   "$value": "#090A0C",
   "$description": "The only raised layer: 3D viewport, alarm band, popovers"
  },
  "surface-hover": {
   "$type": "color",
   "$value": "#141518",
   "$description": "Hover lift on Surface rows and cards; never the only hover signifier"
  },
  "surface-lift": {
   "$type": "color",
   "$value": "#1A1B1E",
   "$description": "Active tool, toast background"
  },
  "line": {
   "$type": "color",
   "$value": "#3C3D41",
   "$description": "Hairlines, grid, separators. Never text"
  },
  "muted": {
   "$type": "color",
   "$value": "#8A8C91",
   "$description": "Labels, units, secondary text, stale values"
  },
